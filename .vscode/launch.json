{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "J-Link",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "device": "${config:device}",
            "interface": "swd",
            "runToEntryPoint": "main",
            "executable": "${config:executable}",
            "serverArgs": [
                "-strict",
                "-timeout",
                "0"
            ],
            "swoConfig": {
                "enabled": false
            },
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "port": 0,
                        "type": "console",
                        "label": "RTT Output",
                        "showOnStartup": true
                    }
                ]
            },
            "svdFile":"${config:svdFile}"
        },
        {
            "name": "ST-Link GDB Server",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "executable": "${config:executable}",
            "device": "${config:device}",
            "interface": "swd",
            "runToEntryPoint": "main",
            "serverArgs": [
                "-l", //limited output log
                "1",
                "-m", //access port ID
                "0",
                "-s", //flash check after load
                "-k" //connect under reset
            ],
            "swoConfig": {
                "enabled": false
            },
            "svdFile":"${config:svdFile}"
        },
        {
            "name": "OpenOCD",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "executable": "${config:executable}",
            "device": "${config:device}",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f0x.cfg"
            ],
            "runToEntryPoint": "main",
            "gdbTarget": "localhost:3333",
            "preLaunchCommands": [
                "monitor arm semihosting enable"
            ],
            "swoConfig": {
                "enabled": false
            },
            "svdFile":"${config:svdFile}"
        },
        {
            "name": "st-util",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stutil",
            "executable": "${config:executable}",
            "device": "${config:device}",
            "runToEntryPoint": "main",
            "swoConfig": {
                "enabled": false
            },
            "svdFile":"${config:svdFile}"
        }
    ]
}